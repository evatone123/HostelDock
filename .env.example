APP_NAME=HostelDock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_MAPS_API_KEY=

# Paystack (booking tokens / per-hostel room payments)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
BOOKING_TOKEN_FEE=70

# MTN MoMo API (per-hostel Collection subscriptions configured via the admin panel)
MTN_MOMO_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_LIVE_BASE_URL=https://momodeveloper.mtn.com
MTN_MOMO_CURRENCY=GHS

# OpenWA (WhatsApp gateway) - leave disabled until OpenWA is running
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=main
OPENWA_ADMIN_ALERT_NUMBER=

WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_APP_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_ACTIVATION_STATUS=pending
WHATSAPP_CLOUD_ADMIN_ALERT_NUMBER=

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
